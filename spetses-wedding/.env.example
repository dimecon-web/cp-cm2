# Configuration du site — à recopier dans les variables d'environnement Vercel
# (Project Settings → Environment Variables), ou dans un fichier .env.local
# pour un développement en local.

# Adresse du projet Supabase
SUPABASE_URL=https://bwedmcyhftxskvkzbyfp.supabase.co

# Clé de service (secrète). Supabase → Project Settings → API Keys → service_role.
# Elle ne doit JAMAIS apparaître côté navigateur : ne la préfixez pas NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Code d'installation, demandé une seule fois à chacun pour créer son mot de
# passe à la première connexion. Choisissez une phrase, communiquez-la de vive
# voix à Themis et Thierry, et changez-la ensuite si vous le souhaitez.
ADMIN_SETUP_CODE=

# ---------- Envoi d'emails (mot de passe oublié) ----------
# Sans ces deux variables, le bouton « Mot de passe oublié ? » le dit
# franchement : l'application n'envoie rien. La voie de secours reste
# disponible — un organisateur connecté remet le compte d'un autre à sa
# première connexion depuis « Mon compte ».
#
# Clé d'API Resend (resend.com, offre gratuite : 100 emails/jour).
RESEND_API_KEY=

# Adresse d'expédition. Tant qu'aucun domaine n'est vérifié chez Resend, seule
# onboarding@resend.dev fonctionne, et uniquement vers l'adresse du compte
# Resend. Pour que Themis et Thierry reçoivent leur lien, il faut vérifier un
# domaine et utiliser une adresse de ce domaine.
MAIL_FROM=

# Adresse publique du site, utilisée pour construire le lien de
# réinitialisation. Facultatif : sans elle, le domaine de la requête est
# utilisé, ce qui convient sur Vercel.
SITE_URL=

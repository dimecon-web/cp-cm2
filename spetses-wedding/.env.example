# Configuration du site — à recopier dans les variables d'environnement Vercel
# (Project Settings → Environment Variables), ou dans un fichier .env.local
# pour un développement en local.
#
# Tant que SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont absentes, le site
# fonctionne en mode démo : les données restent dans le navigateur. Rien ne
# casse, mais les invités ne peuvent pas répondre pour de vrai.

# Adresse du projet Supabase
SUPABASE_URL=https://bwedmcyhftxskvkzbyfp.supabase.co

# Clé de service (secrète). Supabase → Project Settings → API Keys → service_role.
# Elle ne doit JAMAIS apparaître côté navigateur : ne la préfixez pas NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Mot de passe de l'espace organisateurs (témoins, famille proche).
ADMIN_PASSWORD=

# Mot de passe des mariés : mêmes droits, plus l'accès au budget.
# Facultatif — sans lui, personne ne voit le budget.
COUPLE_PASSWORD=
